# Copy this file to .env (NOT committed -- .env is in .gitignore) and fill
# in real values. Every script that needs credentials calls
# nifty_backtester.env_loader.load_env() before reading these, so putting
# them here is enough -- no need to `export` anything by hand.
#
# NEVER commit the real .env file, and never paste real values from it
# into chat, an issue, or anywhere else outside this local file.

# --- ICICI Breeze (market data: historical + live websocket) ---
# BREEZE_API_KEY / BREEZE_API_SECRET are long-lived (from your Breeze API
# app registration). BREEZE_SESSION_TOKEN is SHORT-LIVED -- regenerated
# every login via https://api.icicidirect.com/apiuser/login?api_key=YOUR_API_KEY
# -- overwrite just this one line after each login.
BREEZE_API_KEY=
BREEZE_API_SECRET=
BREEZE_SESSION_TOKEN=

# --- Zerodha / Kite Connect (read-only: current positions only, no price data) ---
# KITE_API_KEY / KITE_API_SECRET are long-lived (from your Kite Connect app
# registration). KITE_API_SECRET is needed only for the one-time
# request_token -> access_token exchange (see scripts/generate_kite_token.py)
# -- it is never sent in the clear, only used to compute a checksum, and is
# NOT needed for ordinary positions()/instruments() calls once you have an
# access_token.
# KITE_ACCESS_TOKEN is valid for ONE TRADING DAY -- regenerated every
# morning by running scripts/generate_kite_token.py (see that script's
# docstring for the login URL). Overwrite just this one line each day.
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
